{
  "name": "nova-builder",
  "version": "1.0.0",
  "private": true,
  "description": "Nova Builder — Gutenberg-native WordPress page builder",
  "scripts": {
    "build": "wp-scripts build src/index.js src/frontend.js --output-path=build",
    "start": "wp-scripts start src/index.js src/frontend.js --output-path=build",
    "lint:js": "wp-scripts lint-js src/",
    "lint:css": "wp-scripts lint-style src/"
  },
  "devDependencies": {
    "@wordpress/scripts": "^30.0.0"
  }
}
