{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "nova-builder/column",
  "title": "NB Column",
  "category": "nova-builder",
  "parent": ["nova-builder/columns"],
  "description": "Individual column inside a Columns block.",
  "attributes": {
    "width": { "type": "string", "default": "" },
    "padding": { "type": "object", "default": {} },
    "background": { "type": "object", "default": {} },
    "verticalAlign": { "type": "string", "default": "" },
    "className": { "type": "string", "default": "" }
  },
  "supports": { "html": false },
  "editorScript": "file:../../index.js",
  "style": "file:../../frontend.css"
}
