{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "nova-builder/cta",
  "title": "NB CTA / Hero",
  "category": "nova-builder",
  "description": "Call-to-action / Hero section with background, overlay, title, subtitle, and up to two buttons.",
  "keywords": ["cta", "hero", "banner", "call to action", "nova"],
  "attributes": {
    "title":          { "type": "string", "source": "html", "selector": ".nb-cta__title",    "default": "Build Something Amazing" },
    "subtitle":       { "type": "string", "source": "html", "selector": ".nb-cta__subtitle", "default": "Nova Builder gives you full control — zero lock-in, clean code, blazing fast." },
    "btn1Text":       { "type": "string", "default": "Get Started" },
    "btn1Url":        { "type": "string", "default": "#" },
    "btn1Style":      { "type": "string", "default": "filled" },
    "btn1Color":      { "type": "string", "default": "#3b82f6" },
    "btn2Text":       { "type": "string", "default": "Learn More" },
    "btn2Url":        { "type": "string", "default": "#" },
    "btn2Style":      { "type": "string", "default": "outlined" },
    "btn2Color":      { "type": "string", "default": "#ffffff" },
    "showBtn2":       { "type": "boolean", "default": true },
    "background":     { "type": "object",  "default": {} },
    "overlayColor":   { "type": "string",  "default": "rgba(0,0,0,0.5)" },
    "showOverlay":    { "type": "boolean", "default": false },
    "minHeight":      { "type": "string",  "default": "500px" },
    "contentAlign":   { "type": "string",  "default": "center" },
    "titleColor":     { "type": "string",  "default": "#ffffff" },
    "subtitleColor":  { "type": "string",  "default": "rgba(255,255,255,0.85)" },
    "padding":        { "type": "object",  "default": { "top": "80px", "right": "20px", "bottom": "80px", "left": "20px" } },
    "className":      { "type": "string",  "default": "" }
  },
  "supports": { "html": false, "align": ["full", "wide"] },
  "editorScript": "file:../../index.js",
  "style": "file:../../frontend.css"
}
